{
  "name": "codex-deepseek-bridge",
  "version": "0.1.0+codex.20260922231453",
  "description": "Codex plugin and MCP bridge for verified parallel provider workers",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "ncc build mcp/server.mjs -o dist -m",
    "check": "node --check mcp/core.mjs && node --check mcp/server.mjs",
    "test": "npm run test:core && npm run test:server",
    "test:core": "node --test test/core.test.mjs",
    "test:server": "node --test test/server.test.mjs",
    "validate": "node scripts/validate.mjs",
    "verify": "npm run check && npm test && npm run build && npm run validate",
    "test:e2e": "node test/e2e.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@vercel/ncc": "0.45.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zadyqs/codex-deepseek-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/zadyqs/codex-deepseek-bridge/issues"
  },
  "homepage": "https://github.com/zadyqs/codex-deepseek-bridge#readme"
}
